[
 {
  "error": "TemplateAssertionError: No filter named 'b64encode'.",
  "name": "ansible filter is not jinja",
  "template": "{{ x | b64encode }}",
  "vars": {
   "x": "a"
  }
 },
 {
  "name": "assume role",
  "template": "{% if role_arn %}{{ role_arn }}{% endif %}",
  "vars": {
   "role_arn": "arn:aws:iam::1:role/x"
  },
  "want": "arn:aws:iam::1:role/x"
 },
 {
  "name": "attribute and item",
  "template": "{{ cfg.a }} {{ cfg['b'] }} [{{ cfg.missing }}]",
  "vars": {
   "cfg": {
    "a": "1",
    "b": "2"
   }
  },
  "want": "1 2 []"
 },
 {
  "name": "booleans",
  "template": "verify={{ on }} {{ off }}",
  "vars": {
   "off": false,
   "on": true
  },
  "want": "verify=True False"
 },
 {
  "name": "comment",
  "template": "a{# hidden #}b",
  "want": "ab"
 },
 {
  "name": "comparison",
  "template": "{{ secret | length > 0 }} {{ not secret }} {{ a and b }} {{ a or b }}",
  "vars": {
   "a": "x",
   "b": "",
   "secret": "s"
  },
  "want": "True False  x"
 },
 {
  "name": "default boolean",
  "template": "{{ region | default('eu-west-1', true) }}",
  "vars": {
   "region": ""
  },
  "want": "eu-west-1"
 },
 {
  "name": "default on empty",
  "template": "[{{ region | default('eu-west-1') }}]",
  "vars": {
   "region": ""
  },
  "want": "[]"
 },
 {
  "name": "default on undefined",
  "template": "{{ region | default('eu-west-1') }}",
  "want": "eu-west-1"
 },
 {
  "name": "dict",
  "template": "{{ dict(a=1)['a'] }}",
  "want": "1"
 },
 {
  "name": "elif on a string",
  "template": "{% if env == 'prod' %}p{% elif env == 'dev' %}d{% else %}x{% endif %}",
  "vars": {
   "env": "dev"
  },
  "want": "d"
 },
 {
  "name": "float",
  "template": "{{ ratio }} {{ '%.2f' | format(ratio) }}",
  "vars": {
   "ratio": 0.5
  },
  "want": "0.5 0.50"
 },
 {
  "name": "format",
  "template": "{{ '%s:%s' | format(user, pw) }}",
  "vars": {
   "pw": "p",
   "user": "u"
  },
  "want": "u:p"
 },
 {
  "name": "if/else on a boolean",
  "template": "{% if verify_ssl %}--verify{% else %}--insecure{% endif %}",
  "vars": {
   "verify_ssl": false
  },
  "want": "--insecure"
 },
 {
  "name": "in",
  "template": "{{ 'prod' in env }} {{ 'x' not in env }}",
  "vars": {
   "env": "prod-eu"
  },
  "want": "True True"
 },
 {
  "name": "indent",
  "template": "cert: |\n  {{ cert | indent(2) }}",
  "vars": {
   "cert": "line1\nline2\nline3"
  },
  "want": "cert: |\n  line1\n  line2\n  line3"
 },
 {
  "name": "integers",
  "template": "{{ port }} {{ port + 1 }} {{ port // 2 }} {{ port / 2 }} {{ 7 % 3 }} {{ 2 ** 10 }}",
  "vars": {
   "port": 8443
  },
  "want": "8443 8444 4221 4221.5 1 1024"
 },
 {
  "name": "is defined",
  "template": "{% if token is defined %}set{% else %}unset{% endif %}",
  "want": "unset"
 },
 {
  "name": "kubeconfig",
  "template": "apiVersion: v1\nkind: Config\nclusters:\n- cluster:\n    server: {{ host }}\n{% if ca_cert %}    certificate-authority-data: {{ ca_cert }}\n{% else %}    insecure-skip-tls-verify: true\n{% endif %}  name: c\nusers:\n- name: u\n  user:\n    token: {{ token }}\n",
  "vars": {
   "ca_cert": "",
   "host": "https://k8s:6443",
   "token": "abc"
  },
  "want": "apiVersion: v1\nkind: Config\nclusters:\n- cluster:\n    server: https://k8s:6443\n    insecure-skip-tls-verify: true\n  name: c\nusers:\n- name: u\n  user:\n    token: abc"
 },
 {
  "name": "list",
  "template": "{{ items }} {{ items | join(',') }} {{ items | first }} {{ items | last }} {{ items | length }}",
  "vars": {
   "items": [
    "a",
    "b"
   ]
  },
  "want": "['a', 'b'] a,b a b 2"
 },
 {
  "name": "loop index",
  "template": "{% for i in items %}{{ loop.index }}={{ i }} {% endfor %}",
  "vars": {
   "items": [
    "x",
    "y"
   ]
  },
  "want": "1=x 2=y "
 },
 {
  "name": "loop over split",
  "template": "{% for h in hosts.split(',') %}{{ h | trim }}{% if not loop.last %};{% endif %}{% endfor %}",
  "vars": {
   "hosts": "a, b ,c"
  },
  "want": "a;b;c"
 },
